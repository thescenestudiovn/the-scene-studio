{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/destinations/layout,_N_T_/destinations/[slug]/layout,_N_T_/destinations/[slug]/page,_N_T_/destinations/da-nang"},"segmentPaths":["/_tree","/_full","/destinations/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"cormorant_garamond_faec1df0-module__IexNYG__variable dm_sans_5a306cfd-module__r_Kq-a__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/01e4147cff8141ee-s.p.3huc2loe0ie8a.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/5c285b27cdda1fe8-s.p.2_mbdogr7ni8i.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/images/stories/haley-david.jpg\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3zvajdqc-a_c6.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/3450qyhportkm.js\" async=\"\"></script><script src=\"/_next/static/chunks/227kwhsrjlnp4.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ycjgud9quol5.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2lyun-2fe6kih.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1a1uul4poymu7.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>The Scene Studio — Destination Wedding Photography &amp; Films</title><meta name=\"description\" content=\"The Scene Studio creates intimate, cinematic photographs and films for destination weddings in Vietnam and beyond.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-[#f7f5f0] text-[#171717]\"><header class=\"fixed left-0 top-0 z-50 w-full px-6 py-5 transition-all duration-500 md:px-10 md:py-6 bg-[#f7f5f0]/95 text-[#171717] backdrop-blur-md\"><nav class=\"flex items-center justify-between\"><a href=\"/\" class=\"font-sans text-xs tracking-[0.2em] uppercase\">The Scene Studio</a><div class=\"hidden items-center gap-8 font-sans text-xs tracking-[0.15em] uppercase md:flex\"><a href=\"/stories\" class=\"transition-opacity hover:opacity-50\">Stories</a><a href=\"/films\" class=\"transition-opacity hover:opacity-50\">Films</a><a href=\"/destinations\" class=\"transition-opacity hover:opacity-50\">Destinations</a><a href=\"/about\" class=\"transition-opacity hover:opacity-50\">About</a><a href=\"/contact\" class=\"transition-opacity hover:opacity-50\">Contact</a></div><button class=\"font-sans text-xs tracking-[0.2em] uppercase md:hidden\">Menu</button></nav></header><div class=\"fixed right-0 top-[58px] z-40 w-[260px] rounded-b-sm bg-[#f7f5f0] p-8 text-[#171717] shadow-xl transition-all duration-300 md:hidden invisible -translate-y-2 opacity-0\"><nav class=\"flex flex-col gap-6\"><a href=\"/stories\" class=\"font-serif text-3xl tracking-[-0.03em]\">Stories</a><a href=\"/films\" class=\"font-serif text-3xl tracking-[-0.03em]\">Films</a><a href=\"/destinations\" class=\"font-serif text-3xl tracking-[-0.03em]\">Destinations</a><a href=\"/about\" class=\"font-serif text-3xl tracking-[-0.03em]\">About</a><a href=\"/contact\" class=\"font-serif text-3xl tracking-[-0.03em]\">Contact</a></nav></div><section class=\"px-6 pb-32 pt-40 md:px-10 md:pb-48 md:pt-52\"><div class=\"mx-auto max-w-7xl\"><p class=\"font-sans text-xs tracking-[0.2em] uppercase\">Central Vietnam</p><h1 class=\"mt-10 max-w-6xl font-serif text-7xl leading-[0.85] tracking-[-0.05em] md:text-9xl\">Da Nang</h1><p class=\"mt-10 max-w-xl font-sans text-sm leading-7 text-[#77736c]\">A coastal city where modern celebrations meet beaches, mountains, and quiet moments.</p></div></section><section class=\"border-t border-[#d8d3ca] px-6 py-32 md:px-10 md:py-48\"><div class=\"mx-auto grid max-w-7xl gap-16 md:grid-cols-12\"><div class=\"md:col-span-4\"><p class=\"font-sans text-xs tracking-[0.2em] uppercase\">The Place</p></div><p class=\"font-serif text-3xl leading-tight tracking-[-0.02em] md:text-5xl\">A coastal city made for celebrations with a sense of place.</p><p class=\"mt-10 font-sans text-sm leading-7 text-[#77736c]\">From beachfront resorts to quiet corners of the city, Da Nang offers an effortless balance between contemporary luxury and the natural beauty of Central Vietnam. It is a place where a wedding can feel intimate, relaxed, and deeply connected to the landscape.</p></div></section><section class=\"border-t border-[#d8d3ca] px-6 py-32 md:px-10 md:py-48\"><div class=\"mx-auto max-w-7xl\"><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Beachside</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">Ocean views, warm light, and celebrations that move naturally from afternoon into sunset.</p></div><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Intimate</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">Private gatherings and smaller celebrations where the people matter more than the production.</p></div><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Modern</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">Contemporary venues and refined details without losing the relaxed character of the coast.</p></div><div class=\"mt-16 grid gap-12 md:grid-cols-3\"><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Intimate</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">Perfect for couples who want a celebration centred around the people who matter most.</p></div><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Destination</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">A meaningful place can turn a wedding into an experience shared across several days.</p></div><div><p class=\"font-serif text-4xl tracking-[-0.03em]\">Unhurried</p><p class=\"mt-5 font-sans text-sm leading-7 text-[#77736c]\">We love celebrations that leave room for conversation, movement, and unexpected moments.</p></div></div></div></section><section class=\"bg-[#171717] px-6 py-32 text-[#f7f5f0] md:px-10 md:py-48\"><div class=\"mx-auto grid max-w-7xl gap-16 md:grid-cols-12\"><div class=\"md:col-span-4\"><p class=\"font-sans text-xs tracking-[0.2em] uppercase text-[#9d9a93]\">Our Approach</p></div><div class=\"md:col-span-7 md:col-start-6\"><p class=\"font-serif text-4xl leading-tight tracking-[-0.03em] md:text-6xl\">We document the way it felt to be there.</p><p class=\"mt-10 font-sans text-sm leading-7 text-[#9d9a93]\">Rather than creating a collection of perfectly posed photographs, we look for the atmosphere, gestures, relationships, and quiet moments that make the day yours.</p></div></div></section><section class=\"border-t border-[#d8d3ca] px-6 py-32 md:px-10 md:py-48\"><div class=\"mx-auto max-w-7xl\"><p class=\"font-sans text-xs tracking-[0.2em] uppercase\">Stories from <!-- -->Da Nang</p><div class=\"mt-16 grid gap-12 md:grid-cols-2\"><a href=\"/stories/haley-david\" class=\"group\"><div class=\"relative aspect-[4/3] overflow-hidden\"><img src=\"/images/stories/haley-david.jpg\" alt=\"Haley &amp; David\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]\"/></div><p class=\"mt-6 font-sans text-xs tracking-[0.15em] uppercase text-[#77736c]\">Intimate Wedding</p><h2 class=\"mt-3 font-serif text-4xl tracking-[-0.03em]\">Haley &amp; David</h2></a></div></div></section><section class=\"px-6 py-32 md:px-10 md:py-48\"><div class=\"mx-auto max-w-5xl text-center\"><p class=\"font-serif text-5xl leading-[0.95] tracking-[-0.03em] md:text-8xl\">Getting married<br/>in <!-- -->Da Nang<!-- -->?</p><a href=\"/contact\" class=\"mt-12 inline-block font-sans text-xs tracking-[0.2em] uppercase transition-opacity hover:opacity-50\">Tell us about your day →</a></div></section><footer class=\"bg-[#171717] px-6 py-16 text-[#f7f5f0] md:px-10 md:py-20\"><div class=\"mx-auto max-w-7xl\"><div class=\"grid gap-16 md:grid-cols-12\"><div class=\"md:col-span-6\"><p class=\"font-sans text-xs tracking-[0.2em] uppercase\">The Scene Studio</p><p class=\"mt-8 max-w-md font-serif text-4xl leading-[0.95] tracking-[-0.03em] md:text-6xl\">Stories worth remembering.</p><p class=\"mt-8 font-sans text-xs tracking-[0.15em] uppercase text-[#9d9a93]\">Da Nang · Vietnam</p></div><div class=\"grid grid-cols-2 gap-10 md:col-span-4 md:col-start-9\"><div><p class=\"font-sans text-xs tracking-[0.15em] uppercase text-[#9d9a93]\">Explore</p><nav class=\"mt-6 flex flex-col gap-4 font-sans text-sm\"><a href=\"/stories\" class=\"transition-opacity hover:opacity-50\">Stories</a><a href=\"/films\" class=\"transition-opacity hover:opacity-50\">Films</a><a href=\"/destinations\" class=\"transition-opacity hover:opacity-50\">Destinations</a><a href=\"/about\" class=\"transition-opacity hover:opacity-50\">About</a><a href=\"/contact\" class=\"transition-opacity hover:opacity-50\">Contact</a></nav></div><div><p class=\"font-sans text-xs tracking-[0.15em] uppercase text-[#9d9a93]\">Connect</p><nav class=\"mt-6 flex flex-col gap-4 font-sans text-sm\"><a href=\"#\" class=\"transition-opacity hover:opacity-50\">Instagram</a><a href=\"mailto:thescenestudiovn@gmail.com\" class=\"transition-opacity hover:opacity-50\">Email</a></nav></div></div></div><div class=\"mt-20 flex flex-col justify-between gap-4 border-t border-white/10 pt-6 font-sans text-[10px] tracking-[0.15em] uppercase text-[#9d9a93] md:flex-row\"><p>© 2026 The Scene St